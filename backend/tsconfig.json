{
  "compilerOptions": {
    "rootDir": "../", 
    "outDir": "./dist",
   "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@shared/*.js": ["../shared/*.ts"],
      "@shared/*": ["../shared/*"],
      "@nbg/shared": ["../shared/src/index.ts"]
}
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules"]
}