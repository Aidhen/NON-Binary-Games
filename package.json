{
  "name": "non-binary-games-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "art"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest",
    "coverage-no-file": "vitest run --coverage --coverage.reporter=text",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p art && tsc --noEmit -p backend && tsc --noEmit -p frontend"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,mjs}": "npm run lint --workspace=frontend -- --fix"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
